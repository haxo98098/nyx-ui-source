<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Nyx: the toolbars are a floating dock. The slab's margin is in the image, so it never
     touches the screen edge; buttons are flat and light up under the mouse. -->
<toolbar pad_left="7"
         pad_right="7"
         pad_top="6"
         pad_bottom="6"
         pad_between="2"
         min_girth="34"
         mouse_opaque="false"
         read_only="false">
  <button_panel name="button_panel"
                bg_opaque_image="Nyx_Dock"
                background_visible="true"
                bg_opaque_image_overlay="White"
                background_opaque="true"/>
  <!-- icon above its label -->
  <button_icon_and_text imgoverlay_label_space="0"
          halign="center"
          image_overlay_alignment="center"
          image_bottom_pad="22"
          image_top_pad="6"
          pad_bottom="-13"
          pad_left="8"
          pad_right="8"
          button_width.min="58"
          button_width.max="120"
          desired_height="46"
          image_unselected="Nyx_DockBtn_Off"
          image_hover_unselected="Nyx_DockBtn_Over"
          image_selected="Nyx_DockBtn_On"
          image_hover_selected="Nyx_DockBtn_On"
          image_pressed="Nyx_DockBtn_Press"
          image_pressed_selected="Nyx_DockBtn_On"
          image_disabled="Nyx_DockBtn_Off"
          image_disabled_selected="Nyx_DockBtn_On"
          image_overlay_color="White"
          label_color="NyxDockLabel"
          label_color_selected="White"
          label_shadow="false"
          hover_glow_amount="0"
          font="SansSerifSmall"
          follows="left|top"
          chrome="true"
          use_ellipses="true"
          auto_resize="true"
          button_flash_count="99999"
          button_flash_rate="1.0"
          flash_color="EmphasisColor"/>
  <button_icon pad_left="11"
          pad_right="11"
          image_bottom_pad="8"
          image_top_pad="8"
          desired_height="34"
          button_width.min="40"
          button_width.max="96"
          label=""
          halign="center"
          image_unselected="Nyx_DockBtn_Off"
          image_hover_unselected="Nyx_DockBtn_Over"
          image_selected="Nyx_DockBtn_On"
          image_hover_selected="Nyx_DockBtn_On"
          image_pressed="Nyx_DockBtn_Press"
          image_pressed_selected="Nyx_DockBtn_On"
          image_disabled="Nyx_DockBtn_Off"
          image_disabled_selected="Nyx_DockBtn_On"
          image_overlay_color="White"
          label_color="NyxDockLabel"
          label_color_selected="White"
          label_shadow="false"
          hover_glow_amount="0"
          font="SansSerifSmall"
          follows="left|top"
          chrome="true"
          use_ellipses="true"
          auto_resize="true"
          button_flash_count="99999"
          button_flash_rate="1.0"
          flash_color="EmphasisColor"/>
  <button halign="center"
          button_width.min="64"
          button_width.max="140"
          desired_height="34"
          pad_left="12"
          pad_right="12"
          image_unselected="Nyx_DockBtn_Off"
          image_hover_unselected="Nyx_DockBtn_Over"
          image_selected="Nyx_DockBtn_On"
          image_hover_selected="Nyx_DockBtn_On"
          image_pressed="Nyx_DockBtn_Press"
          image_pressed_selected="Nyx_DockBtn_On"
          image_disabled="Nyx_DockBtn_Off"
          image_disabled_selected="Nyx_DockBtn_On"
          image_overlay_color="White"
          label_color="NyxDockLabel"
          label_color_selected="White"
          label_shadow="false"
          hover_glow_amount="0"
          font="SansSerifSmall"
          follows="left|top"
          chrome="true"
          use_ellipses="true"
          auto_resize="true"
          button_flash_count="99999"
          button_flash_rate="1.0"
          flash_color="EmphasisColor"/>
</toolbar>
